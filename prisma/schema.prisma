generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id              String   @id @default(cuid())
  title           String
  createdAt       DateTime @default(now())
  dueAt           DateTime
  durationMinutes Int
  priority        Int      @default(2)
}

model BusyBlock {
  id        String    @id @default(cuid())
  start     DateTime
  end       DateTime
  createdAt DateTime  @default(now())
}
